generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  dealsCreated        Deal[]           @relation("CreatedBy")
  investments         DealInvestment[]
  paymentsRecorded    Payment[]
  settlementsPaid     DebtSettlement[] @relation("Payer")
  settlementsReceived DebtSettlement[] @relation("Payee")
  settlementsRecorded DebtSettlement[] @relation("RecordedBy")
}

model Customer {
  id             String   @id @default(uuid())
  fullName       String
  phonePrimary   String
  phoneSecondary String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now())

  deals Deal[]
}

model Deal {
  id                 String     @id @default(uuid())
  customerId         String
  productName        String
  cost               Decimal    @db.Decimal(12, 2)
  sellingPrice       Decimal    @db.Decimal(12, 2)
  markupAmount       Decimal    @db.Decimal(12, 2)
  markupPercent      Decimal    @db.Decimal(6, 2)
  advancePayment     Decimal    @db.Decimal(12, 2) @default(0)
  installmentMonths  Int
  monthlyInstallment Decimal    @db.Decimal(12, 2)
  startDate          DateTime   @db.Date
  storeName          String?
  productPhotoUrl    String?
  receiptPhotoUrl    String?
  notes              String?
  status             DealStatus @default(ACTIVE)
  createdById        String
  createdAt          DateTime   @default(now())

  customer     Customer         @relation(fields: [customerId], references: [id])
  createdBy    User             @relation("CreatedBy", fields: [createdById], references: [id])
  investments  DealInvestment[]
  installments Installment[]
  payments     Payment[]
}

enum DealStatus {
  ACTIVE
  SETTLED
}

model DealInvestment {
  id                   String  @id @default(uuid())
  dealId               String
  investorId           String
  expectedContribution Decimal @db.Decimal(12, 2)
  actualContribution   Decimal @db.Decimal(12, 2)
  reinvestedAmount     Decimal @db.Decimal(12, 2) @default(0)
  debtAmount           Decimal @db.Decimal(12, 2)

  deal     Deal @relation(fields: [dealId], references: [id])
  investor User @relation(fields: [investorId], references: [id])

  @@unique([dealId, investorId])
}

model Installment {
  id                String            @id @default(uuid())
  dealId            String
  installmentNumber Int
  dueDate           DateTime          @db.Date
  amountDue         Decimal           @db.Decimal(12, 2)
  amountPaid        Decimal           @db.Decimal(12, 2) @default(0)
  status            InstallmentStatus @default(PENDING)

  deal     Deal      @relation(fields: [dealId], references: [id])
  payments Payment[]
}

enum InstallmentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  MISSED
}

model Payment {
  id            String   @id @default(uuid())
  dealId        String
  installmentId String
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @db.Date
  recordedById  String
  notes         String?
  createdAt     DateTime @default(now())

  deal        Deal        @relation(fields: [dealId], references: [id])
  installment Installment @relation(fields: [installmentId], references: [id])
  recordedBy  User        @relation(fields: [recordedById], references: [id])
}

model DebtSettlement {
  id             String   @id @default(uuid())
  payerId        String
  payeeId        String
  amount         Decimal  @db.Decimal(12, 2)
  settlementDate DateTime @db.Date
  notes          String?
  recordedById   String
  createdAt      DateTime @default(now())

  payer      User @relation("Payer", fields: [payerId], references: [id])
  payee      User @relation("Payee", fields: [payeeId], references: [id])
  recordedBy User @relation("RecordedBy", fields: [recordedById], references: [id])
}
